+                published_at = ?,
+                promoted = ?,
+                prompt_personalizado = ?,
+                prompt_copy = ?,
+                meta_pauta_inicio = ?,
+                meta_pauta_fin = ?,
+                es_carrusel = ?,
+                carousel_images = ?,
+                updated_at = ?
+            WHERE id = ?
+        `).run(
+            data.designed ? 1 : 0,
+            data.published ? 1 : 0,
+            data.published ? now : null,
+            data.promoted ? 1 : 0,
+            data.prompt || null,
+            data.promptCopy || null,
+            meta_pauta_inicio,
+            meta_pauta_fin,
+            data.esCarrusel ? 1 : 0,
